rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usernames/{name} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
                  || resource.data.publicProfile == true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // Calendar events: owner full access; public read only for events marked public.
      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == uid
                    || resource.data.isPublic == true;
        // Writes go through the Admin SDK API routes.
        allow write: if false;
      }

      // Per-event private metadata (round name, outcome, notes). Owner-only.
      match /eventNotes/{eventId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Opportunities (job-pipeline items). Only the *safe* fields live here.
      // The `private` subcollection below holds notes/feedback/contacts (never publicly readable).
      match /opportunities/{oppId} {
        allow read: if request.auth != null && request.auth.uid == uid
                    || resource.data.isPublic == true;
        allow write: if false;

        match /private/{docId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }

      // OAuth refresh tokens (v2+): never client-readable.
      match /oauth/{provider} {
        allow read, write: if false;
      }
    }
  }
}
