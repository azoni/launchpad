# MacroMarket environment variables.
# Copy to .env.local for local dev; set the same keys in Netlify for production.
# The app runs with NONE of these set (curated baseline prices, no AI coach, no
# dashboard) — each key below unlocks one capability.

# --- Site ---
NEXT_PUBLIC_APP_URL=https://macromarket-app.netlify.app

# --- AI protein coach (Anthropic) ---
# Without this the /coach endpoint returns "not configured".
ANTHROPIC_API_KEY=

# --- Amazon Creators API: LIVE PRICING + DEALS ---
# IMPORTANT: live pricing is DOUBLE-gated. Both must be true or the catalog stays
# on curated baseline "estimate" prices:
#   1) AMAZON_CLIENT_ID + AMAZON_CLIENT_SECRET must be valid, AND
#   2) AMAZON_LIVE_PRICING must equal exactly "1"  (NOT "true", NOT "0").
# This gate is the macromarket equivalent of oldways' AMAZON_REFRESH_ENABLED — the
# name differs, so copying oldways' env verbatim will NOT turn live pricing on.
AMAZON_LIVE_PRICING=0
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=oldwaystoda00-20

# --- Firebase Admin (server-only): price cache + affiliate-click & chat logging ---
# Enables the 6h Firestore price cache and the public /stats dashboard. Raw JSON or
# base64-encoded service-account JSON (base64 preferred — see lib/firebase/admin.ts).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Launchpad analytics + LLM cost feed (shared portfolio keys) ---
NEXT_PUBLIC_MCP_READ_KEY=
MCP_ADMIN_KEY=

# --- USDA FoodData Central (protein provenance enrichment script) ---
USDA_FDC_API_KEY=

# --- On-demand ISR revalidation (optional; POST /api/revalidate?secret=...) ---
REVALIDATE_SECRET=

# --- Admin panel (/admin) — manage blog posts + AI draft generation ---
# The key you type into /admin to unlock it. Falls back to MCP_ADMIN_KEY if unset.
ADMIN_KEY=

# --- Optional analytics / ads (scripts load only when set) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_ADSENSE_ID=
