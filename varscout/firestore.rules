rules_version = '2';

// Varscout stores only public market statistics, but nothing here is meant to
// be read or written by a browser. The collector writes with a service account
// (which bypasses these rules) and the app serves history through the cached
// /api/aggregates route. Denying all client access keeps read quota bounded and
// leaves no client-writable surface.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
